# ===================================
# TESTING ENVIRONMENT
# Local testing on your machine (isolated from dev)
# Ports: Frontend=3001, Backend=4001, MySQL=33062, Portal=7778
# ===================================

# Backend Configuration
NODE_ENV=test
PORT=4001

# Database Configuration (SCL Test Database - isolated from dev)
DB_HOST=scli-mysql-test
DB_PORT=3306
DB_USER=scl_user
DB_PASS=scl_password_test
DB_NAME=scl_institute_test

# Frontend Configuration
VITE_API_URL=http://localhost:4001/api
VITE_ENV=test

# Moodle Configuration (WSL LAMP - same instance, read-only for testing)
MOODLE_URL=http://localhost:9090
MOODLE_DATABASE_HOST=host.docker.internal
MOODLE_DATABASE_PORT=3306
MOODLE_DATABASE_USER=moodleuser
MOODLE_DATABASE_PASSWORD=moodlepass
MOODLE_DATABASE_NAME=moodle

# Security
SSO_SECRET=test-supersecretkey-donotuse-inprod

# MySQL Configuration
MYSQL_ROOT_PASSWORD=testRootPassword!
MYSQL_DATABASE=scl_institute_test
MYSQL_USER=scl_user
MYSQL_PASSWORD=scl_password_test

# MariaDB/Moodle Configuration (unused in test - Moodle runs on WSL)
MARIADB_ROOT_PASSWORD=moodleroot
MARIADB_DATABASE=bitnami_moodle
MARIADB_USER=bn_moodle
MARIADB_PASSWORD=bitnami_moodle_password
MARIADB_CHARACTER_SET=utf8mb4
MARIADB_COLLATE=utf8mb4_unicode_ci

# Moodle Credentials
MOODLE_USERNAME=admin
MOODLE_PASSWORD=SCLInst!2026
MOODLE_SITE_NAME=SCL Institute LMS (Testing)

# Moodle API Configuration
MOODLE_TOKEN=e86dd021aaa42f78114e6c67cc9d8ff1
